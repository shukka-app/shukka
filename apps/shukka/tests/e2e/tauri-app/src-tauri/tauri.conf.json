{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shukka-e2e",
  "version": "1.0.0",
  "identifier": "dev.shukka.e2e",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "shukka-e2e",
        "width": 200,
        "height": 200,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "DUMMY",
      "endpoints": ["https://example.invalid/update"],
      "dangerousInsecureTransportProtocol": true
    }
  }
}
