{
  "name": "shukka",
  "private": true,
  "version": "1.1.0",
  "license": "MIT",
  "description": "Self-hosted release manager for Electron, Tauri, and Sparkle apps that update through S3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shukka-app/shukka.git"
  },
  "bugs": {
    "url": "https://github.com/shukka-app/shukka/issues"
  },
  "homepage": "https://github.com/shukka-app/shukka#readme",
  "keywords": [
    "electron",
    "electron-updater",
    "electron-builder",
    "tauri",
    "sparkle",
    "self-hosted",
    "s3",
    "auto-update"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:worker": "vite build --config vite.config.worker.ts",
    "deploy:worker": "npm run build:worker && wrangler deploy",
    "check:worker-size": "node scripts/check-worker-size.mjs",
    "lint": "oxlint",
    "start": "node .output/server/index.mjs",
    "generate:routes": "tsr generate",
    "pretypecheck": "npm run generate:routes",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "npm ci --prefix tests/e2e && node tests/e2e/run.mjs",
    "test:e2e:rollback": "npm ci --prefix tests/e2e && node tests/e2e/run-rollback.mjs",
    "test:e2e:tauri": "node tests/e2e/run-tauri.mjs",
    "test:e2e:sparkle": "node tests/e2e/run-sparkle.mjs",
    "test:e2e:sparkle:macos": "node tests/e2e/run-sparkle-macos.mjs",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:remote": "node scripts/migrate-remote.mjs",
    "juicefs": "node scripts/juicefs-dev.mjs",
    "lint:actions": "actionlint"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "@milkdown/crepe": "^7.22.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-start": "^1.168.46",
    "aws4fetch": "^1.0.20",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "github-slugger": "^2.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.31.0",
    "mdast-util-to-string": "^4.0.0",
    "nuqs": "^2.9.6",
    "pinyin-pro": "^3.29.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-call": "^2.0.2",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "simple-icons": "^16.28.0",
    "sonner": "^2.0.8",
    "std-env": "^4.2.0",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.33",
    "@types/github-slugger": "^1.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "drizzle-kit": "^0.31.10",
    "nitro": "^3.0.260610-beta",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.127.1"
  }
}
